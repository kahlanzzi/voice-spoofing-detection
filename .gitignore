# =============================================================================
# .gitignore — never commit secrets, data, models, or local tool state.
# Based on the CS 488 starter template (secrets / editor / logs / Python).
# =============================================================================

# --- Secrets & local environment (NEVER commit these) -----------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
kaggle.json
.DS_Store
Thumbs.db

# --- Local AI-tool overrides (personal, not shared; AGENTS.md is the shared one)
CLAUDE.local.md
AGENTS.override.md
.claude/settings.local.json

# --- Editor / IDE ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.sample.json
.idea/
*.swp
*.swo
*~

# --- Logs & temp -------------------------------------------------------------
*.log
logs/
tmp/
# runtime API database (configs/api.yaml database_path)
var/
.cache/
coverage/
.coverage
htmlcov/

# --- Data: nothing but manifests and the README is committed (hard rule 7) --
data/*
!data/manifests/
data/manifests/*
!data/manifests/.gitkeep
!data/manifests/*.csv
!data/README.md

# --- Audio / models / features ----------------------------------------------
*.wav
*.flac
*.mp3
*.pt
*.ckpt
*.npy

# --- Audit + experiment outputs ----------------------------------------------
audit_out/
wandb/
docs/audit_evidence/stage4_split/for2sec_split_assignments.csv

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
