  "conventions": {
    "1_cnn": "CNN in H1 and H5 = the bundle-seed CNN (role cnn_bundle_seed, seed from run_report.json); seeds 1-2 at score level only (Protocol \u00a75, D45)",
    "2_score_level": "EER and ROC-AUC on raw_score for every model, never on p",
    "3_subgroups": "score level: REAL vs FAKE_mp3 and REAL vs FAKE_other; decision level: each subgroup alone (binary_metrics / three_way_metrics on the subset)",
    "4_decision_level": "bundle CNN: forced binary = binary_metrics(labels, p, policy.threshold), three-way = three_way_metrics(labels, stored prediction); baseline: forced binary only, binary_metrics(labels, raw_score, Stage 7 val_b_threshold) (D4, D29)",
