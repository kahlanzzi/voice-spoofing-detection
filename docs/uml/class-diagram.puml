@startuml
!pragma layout smetana
title Voice-spoofing detection — API and analyzer class model

skinparam shadowing false
skinparam backgroundColor white
skinparam class {
  BackgroundColor<<implemented>> #E8F5E9
  BorderColor<<implemented>> #2E7D32
  BackgroundColor<<planned>> #FFF8E1
  BorderColor<<planned>> #B26A00
  BackgroundColor<<framework>> #E3F2FD
  BorderColor<<framework>> #1565C0
}

package "Implemented API skeleton" {
  class "create_app(config)" as CreateApp <<implemented>> {
    +create_app(config: ApiConfig | None): FastAPI
  }

  class ApiConfig <<implemented>> {
    +formats: tuple[str]
    +max_size_bytes: int
    +max_duration_s: int
    +audio_deletion: str
    +analysis_timeout_s: int
    +page_size_max: int
    +note_max_chars: int
    +stats_time_zone: str
    +notice_text: str
    +mock_deferral_on_fit: float
    +temp_dir: str | None
  }

  class RequestIdMiddleware <<implemented>> {
    -app: ASGIApp
    +__call__(scope, receive, send): None
  }

  class ApiError <<implemented>> {
    +status: int
    +code: str
    +message: str
    +request_id: str | None
  }

  abstract class StrictModel <<implemented>>
  class AnalysisResponse <<implemented>> {
    +prediction: authentic | synthetic | uncertain
    +confidence: float [0,1]
    +risk_level: LOW | MEDIUM | HIGH
    +model_version: str
    +profile_version: str
    +policy_version: str
    +request_id: str
    +notice: str
  }
  class Note <<implemented>> {
    +text: str
    +updated_at: str
  }
  class StoredAnalysis <<implemented>> {
    +created_at: str
  }
  class ErrorDetail <<implemented>> {
    +code: str
    +message: str
    +request_id: str | None
  }
  class Error <<implemented>>
  class StatusChecks <<implemented>> {
    +analysis: available | unavailable
    +history_and_stats: available | unavailable
  }
  class StatusVersions <<implemented>> {
    +model_version: str
    +profile_version: str
    +policy_version: str
  }
  class StatusResponse <<implemented>> {
    +state: ready | degraded | unavailable
    +checked_at: str
    +bundle_manifest_sha256: str | None
    +deferral_on_fit: float
    +mock: bool
  }
}

package "Planned Stage 17 services" {
  interface Analyzer <<planned>> {
    +analyze(path: Path): AnalysisOutcome
    +info(): AnalyzerInfo
  }
  class AnalysisOutcome <<planned>> {
    +prediction: str
    +confidence: float
    +risk_level: str
    +model_version: str
    +profile_version: str
    +policy_version: str
  }
  class AnalyzerInfo <<planned>> {
    +ready: bool
    +versions: StatusVersions
    +deferral_on_fit: float
    +bundle_manifest_sha256: str | None
    +mock: bool
  }
  class MockAnalyzer <<planned>>
  class BundleAnalyzer <<planned>>
  interface AnalysisRepository <<planned>> {
    +save(record: AnalysisRecord): None
    +list(filters, page): list[StoredAnalysis]
    +get(request_id: str): StoredAnalysis | None
    +put_note(request_id: str, text: str): Note | None
    +stats(period): Stats
  }
  class AnalysisRecord <<planned>> {
    +request_id: str
    +created_at: str
    +processing_ms: int
    +is_mock: bool
    +analysis: AnalysisResponse
  }
  class AnalysisNote <<planned>> {
    +request_id: str
    +text: str
    +updated_at: str
  }
}

package "Implemented shared core" {
  class LoadedBundle <<implemented>> {
    +directory: Path
    +manifest: BundleManifest
    +checkpoint_path: Path
    +profile_path: Path
    +policy: RiskPolicy
    +manifest_sha256: str
  }
  class BundleManifest <<implemented>> {
    +schema_version: int
    +bundle_version: str
    +code_commit: str
    +protocol_version: str
    +f2_ledger_sha256: str
  }
  class Component <<implemented>> {
    +file: str
    +sha256: str
    +version: str
  }
  class PreprocessingProfile <<implemented>>
  class CNN <<implemented>>
  class RiskPolicy <<implemented>>
}

class FastAPI <<framework>>

StrictModel <|-- AnalysisResponse
StrictModel <|-- Note
StrictModel <|-- StoredAnalysis
StrictModel <|-- ErrorDetail
StrictModel <|-- Error
StrictModel <|-- StatusChecks
StrictModel <|-- StatusVersions
StrictModel <|-- StatusResponse

StoredAnalysis *-- "1" AnalysisResponse
StoredAnalysis o-- "0..1" Note
Error *-- "1" ErrorDetail
StatusResponse *-- "1" StatusChecks
StatusResponse *-- "1" StatusVersions

CreateApp ..> ApiConfig : loads
CreateApp ..> FastAPI : creates
FastAPI *-- RequestIdMiddleware : middleware
FastAPI ..> ApiError : handles
FastAPI ..> StatusResponse : current route returns

Analyzer <|.. MockAnalyzer
Analyzer <|.. BundleAnalyzer
Analyzer --> AnalysisOutcome
Analyzer --> AnalyzerInfo
AnalysisRecord *-- "1" AnalysisResponse
AnalysisRecord o-- "0..1" AnalysisNote
AnalysisRepository ..> AnalysisRecord
AnalysisRepository ..> AnalysisNote

BundleAnalyzer ..> LoadedBundle : verifies and loads
LoadedBundle *-- "1" BundleManifest
BundleManifest *-- "3" Component
LoadedBundle *-- "1" RiskPolicy
BundleAnalyzer ..> PreprocessingProfile
BundleAnalyzer ..> CNN

note right of AnalysisRepository
  Contract-derived interface, not code on main.
  SQLite-on-volume is the approved first design.
end note

note bottom of CreateApp
  Current main includes only GET /api/status.
  Upload, analyzer and repository wiring are planned.
end note
@enduml
