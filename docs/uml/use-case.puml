@startuml
!pragma layout smetana
title Figure 1 — Merged use-case model: submission, review, research evaluation and operations
left to right direction

skinparam shadowing false
skinparam backgroundColor white
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FCE8E6
  BorderColor #9E1B16
}
skinparam rectangle {
  BorderColor #9E1B16
}

actor "Fraud Prevention\nAnalyst" as Analyst
actor "API Client\n<<external system>>" as ApiClient
actor "ML / Research\nEngineer" as Engineer
actor "Compliance\nOfficer" as Compliance
actor "Operations /\nSecurity Administrator" as Operations

rectangle "Voice-Spoofing Detection & Risk Scoring System" {
  usecase "UC-01\nAnalyze Audio via\nDashboard" as UC01
  usecase "UC-02\nAnalyze Audio via API" as UC02
  usecase "UC-03\nValidate & Analyze\nAudio" as UC03
  usecase "UC-04\nRecord Analysis\nMetadata" as UC04
  usecase "UC-05\nReview Analysis History" as UC05
  usecase "UC-06\nAnnotate Result" as UC06
  usecase "UC-07\nRun Model Evaluation" as UC07
  usecase "UC-08\nRun External\nGeneralization Test" as UC08
  usecase "UC-09\nView Evaluation Report" as UC09
  usecase "UC-10\nReview Service Logs" as UC10
}

Analyst --> UC01
Analyst --> UC05
Analyst --> UC06
ApiClient --> UC02
Engineer --> UC07
Engineer --> UC08
Engineer --> UC09
Compliance --> UC09
Operations --> UC10

UC01 .> UC03 : <<include>>
UC02 .> UC03 : <<include>>
UC03 .> UC04 : <<include>>
UC05 .> UC04 : <<include>>
UC06 .> UC04 : <<include>>
UC06 .> UC05 : <<extend>>

legend bottom
  Solid line = actor association
  Dashed arrow <<include>> = base use case to required shared use case
  Dashed arrow <<extend>> = optional extension to base use case
endlegend

note bottom of UC01
  D38 update: Dashboard is implemented as the React analyst web app.
  The UC-01 goal and actor remain unchanged.
end note
@enduml
