# Copy this file to `.env` and fill in real values. NEVER commit your real .env.
# `.env` is gitignored; `.env.example` is committed so teammates know what's needed.
#
#   cp .env.example .env
#
# Placeholders only. Never paste real tokens into an AI chat or prompt.

# Kaggle API token (DEEP-VOICE download only; see AGENTS.md hard rule 1 / D20)
KAGGLE_API_TOKEN=your-kaggle-api-token-here

# Hugging Face token (FoR-2sec download)
HF_TOKEN=your-huggingface-token-here

# W&B API key (D40). Put your own key in .env only; never commit it or paste it into code, notebooks or AI prompts.
WANDB_API_KEY=

# API sign-in (D47, docs/api_design.md §4.8): HMAC key for the failed sign-in counts; at least 32
# random bytes, hex. Make your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Environment only: never in configs/, code, a log or an AI prompt. Changing it only resets lockout counts.
VSD_SIGNIN_HMAC_KEY=

# PostgreSQL store (D53 (4), docs/setup.md "Database"). Two passwords, each at least 32 random bytes, hex.
# Make each one with:
#   openssl rand -hex 32
# VSD_DB_PASSWORD: the database superuser; used only by the db container's first start. The api never gets it.
# VSD_DB_APP_PASSWORD: the API's own role (vsd_app, not a superuser); the api and api.admin connect with it.
# Both are read once, when the vsd-pg volume is created: changing them later needs the steps in docs/setup.md.
# Environment only: never in configs/, code, a log or an AI prompt.
VSD_DB_PASSWORD=
VSD_DB_APP_PASSWORD=
